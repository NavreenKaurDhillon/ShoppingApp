<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/home_screen">

    <fragment
        android:id="@+id/home_screen"
        android:name="com.example.demopaginationapp.view.fragments.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/categories_screen"
        android:name="com.example.demopaginationapp.view.fragments.CategoriesFragment"
        android:label="Categories"
        tools:layout="@layout/fragment_categories" />

    <fragment
        android:id="@+id/brand_screen"
        android:name="com.example.demopaginationapp.view.fragments.BrandFragment"
        android:label="Brands"
        tools:layout="@layout/fragment_brand" />

    <fragment
        android:id="@+id/fav_screen"
        android:name="com.example.demopaginationapp.view.fragments.FavFragment"
        android:label="Favorites"
        tools:layout="@layout/fragment_fav" />

    <fragment
        android:id="@+id/cart_screen"
        android:name="com.example.demopaginationapp.view.fragments.CartFragment"
        android:label="Cart"
        tools:layout="@layout/fragment_cart" />

    <fragment
        android:id="@+id/quotes_list_screen"
        android:name="com.example.demopaginationapp.view.fragments.QuotesListFragment"
        android:label="Quotes"
        tools:layout="@layout/fragment_quotes_list" />

    <fragment
        android:id="@+id/product_screen"
        android:name="com.example.demopaginationapp.view.fragments.ProductFragment"
        android:label="Products"
        tools:layout="@layout/fragment_product" />

    <fragment
        android:id="@+id/search_screen"
        android:name="com.example.demopaginationapp.view.fragments.SearchFragment"
        android:label="Search"
        tools:layout="@layout/fragment_search" />

    <fragment
        android:id="@+id/detail_screen"
        android:name="com.example.demopaginationapp.view.fragments.DetailFragment"
        android:label="Detail"
        tools:layout="@layout/fragment_detail">
        <argument
            android:name="data"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/product_detail_screen"
        android:name="com.example.demopaginationapp.view.fragments.ProductDetailFragment"
        android:label="Product Detail"
        tools:layout="@layout/fragment_product_detail">
        <argument
            android:name="data"
            app:argType="string" />
    </fragment>

</navigation>